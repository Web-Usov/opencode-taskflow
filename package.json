{
  "name": "opencode-taskflow",
  "version": "0.2.0",
  "description": "OpenCode V2 execution extension for existing OpenSpec changes: worktrees, role agents, PR review and merge-safe cleanup; standalone Taskflow compatibility",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts"
  },
  "files": ["index.ts", "src", "templates", "docs", "scripts/smoke-openspec.ts", "README.md", "LICENSE"],
